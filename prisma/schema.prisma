generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ShopStatus {
  DRAFT
  OPEN
  PAUSED
  TAKEN_DOWN
}

enum ShopLanguage {
  en
  hi
  ta
  kn
  te
  ml
}

enum StockMode {
  TRACKED
  MADE_TO_ORDER
}

enum Fulfilment {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  NEW
  CONFIRMED
  READY
  DELIVERED
  CANCELLED
}

enum ReportReason {
  SCAM
  PROHIBITED
  OFFENSIVE
  IMPERSONATION
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  shop         Shop?
}

model Shop {
  id             String       @id @default(cuid())
  ownerId        String       @unique
  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  slug           String       @unique @db.VarChar(40)
  name           String       @db.VarChar(60)
  emphasis       String?      @db.VarChar(60)
  tagline        String?      @db.VarChar(120)
  logoUrl        String?
  logoKey        String?
  bannerUrl      String?
  bannerKey      String?
  /// E.164 digits without "+", always "91" followed by 10 digits.
  whatsapp       String?      @db.VarChar(12)
  address        String?      @db.VarChar(240)
  mapUrl         String?      @db.VarChar(500)
  /// Seven entries (Sunday first): { closed, open: "HH:MM", close: "HH:MM" }.
  hours          Json?
  pickup         Boolean      @default(true)
  delivery       Boolean      @default(false)
  deliveryNote   String?      @db.VarChar(240)
  accentHex      String       @default("#E07A4F") @db.Char(7)
  language       ShopLanguage @default(en)
  status         ShopStatus   @default(DRAFT)
  setupStep      Int          @default(1)
  orderSeq       Int          @default(0)
  isDemo         Boolean      @default(false)
  takedownReason String?      @db.VarChar(240)
  openedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  categories   Category[]
  products     Product[]
  photos       ProductPhoto[]
  orders       Order[]
  dailyStats   DailyStat[]
  productStats ProductDailyStat[]
  reports      Report[]

  @@index([status])
}

model Category {
  id       String    @id @default(cuid())
  shopId   String
  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name     String    @db.VarChar(40)
  position Int       @default(0)
  products Product[]

  @@unique([shopId, name])
  @@index([shopId, position])
}

model Product {
  id          String    @id @default(cuid())
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String    @db.VarChar(80)
  description String?   @db.VarChar(600)
  stockMode   StockMode @default(MADE_TO_ORDER)
  stockQty    Int?
  inStock     Boolean   @default(true)
  featured    Boolean   @default(false)
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  variants   Variant[]
  photos     ProductPhoto[]
  orderItems OrderItem[]
  stats      ProductDailyStat[]

  @@index([shopId, position])
  @@index([shopId, categoryId])
}

model Variant {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Empty string for a product sold in one size only.
  label      String  @default("") @db.VarChar(40)
  pricePaise Int
  position   Int     @default(0)

  orderItems OrderItem[]

  @@unique([productId, label])
  @@index([productId, position])
}

model ProductPhoto {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  shopId     String
  shop       Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  url        String
  storageKey String
  width      Int
  height     Int
  position   Int     @default(0)

  @@index([productId, position])
  @@index([shopId])
}

model Order {
  id              String      @id @default(cuid())
  shopId          String
  shop            Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  seq             Int
  /// Public code customers use to check status, e.g. "0142-K7QX".
  code            String      @db.VarChar(12)
  /// Random key generated by the customer's browser so a double tap never creates two orders.
  clientKey       String      @db.VarChar(64)
  customerName    String      @db.VarChar(60)
  fulfilment      Fulfilment
  address         String?     @db.VarChar(240)
  note            String?     @db.VarChar(240)
  totalPaise      Int
  itemCount       Int
  status          OrderStatus @default(NEW)
  stockApplied    Boolean     @default(false)
  /// Set when the customer taps "Send on WhatsApp". Unsent previews never reach the owner's inbox.
  sentAt          DateTime?
  createdAt       DateTime    @default(now())
  statusChangedAt DateTime    @default(now())
  items           OrderItem[]

  @@unique([shopId, seq])
  @@unique([shopId, code])
  @@unique([shopId, clientKey])
  @@index([shopId, status, createdAt(sort: Desc)])
  @@index([shopId, sentAt(sort: Desc)])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId    String?
  variant      Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name         String   @db.VarChar(80)
  variantLabel String   @db.VarChar(40)
  unitPaise    Int
  qty          Int
  linePaise    Int

  @@index([orderId])
  @@index([productId])
}

model DailyStat {
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  day          DateTime @db.Date
  storeViews   Int      @default(0)
  productViews Int      @default(0)
  waClicks     Int      @default(0)

  @@id([shopId, day])
}

model ProductDailyStat {
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  views     Int      @default(0)

  @@id([productId, day])
  @@index([shopId, day])
}

model Report {
  id         String       @id @default(cuid())
  shopId     String
  shop       Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  reason     ReportReason
  details    String?      @db.VarChar(600)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  @@index([resolvedAt, createdAt])
  @@index([shopId])
}

/// Anonymous platform usage counters ("Used by N shops"). No personal data.
model PlatformEvent {
  id        String   @id @default(cuid())
  type      String   @db.VarChar(32)
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}
