# Postgres connection string. On Neon use the *pooled* URL from the dashboard
# (Connection details -> Pooled connection). sslmode=require is needed on Neon.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Secret used by Auth.js to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Comma-separated emails that can open /admin to review reports and take shops down.
ADMIN_EMAILS="you@example.com"

# Public base URL of the site, used for QR codes, share links and Open Graph images.
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional. Vercel Blob read-write token for product photos, logos and banners.
# Leave empty locally: photos are then saved to public/uploads on your disk.
# On Vercel: Storage -> Create -> Blob, connect it to the project, and this is set for you.
BLOB_READ_WRITE_TOKEN=""
